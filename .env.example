# Copy file này thành .env và điền giá trị thực.

# ── Upstream ────────────────────────────────────────────────────────────────
# Base URL của hệ thống nhận inbound (webhook tin đến, sự kiện) và cấp danh sách
# phiên để khôi phục khi service khởi động.
# Local dev:  http://localhost:5000
UPSTREAM_BASE_URL=http://localhost:5000

# Đường webhook nhận inbound phía upstream. Service POST tới:
#   {UPSTREAM_BASE_URL}{UPSTREAM_WEBHOOK_PATH}            → tin nhắn đến
#   {UPSTREAM_BASE_URL}{UPSTREAM_WEBHOOK_PATH}/reaction   → thả cảm xúc
#   {UPSTREAM_BASE_URL}{UPSTREAM_WEBHOOK_PATH}/recall     → thu hồi tin
#   … /typing, /delivered, /seen, /group-event, /friend-event
UPSTREAM_WEBHOOK_PATH=/api/v1/webhook/zalo-personal

# Endpoint upstream trả danh sách phiên cần khôi phục (kèm cookies đã lưu).
# Service gọi GET endpoint này lúc khởi động để tự đăng nhập lại, khỏi quét QR.
UPSTREAM_SESSIONS_PATH=/api/v1/channels/zalo-personal/internal/sessions

# Khoá gửi kèm header X-System-Key khi gọi upstream. Phải khớp với khoá upstream
# yêu cầu, nếu không upstream trả 401 và inbound Zalo bị rớt.
SYSTEM_KEY=

# ── Service ─────────────────────────────────────────────────────────────────
# Port service lắng nghe (mặc định 3100)
PORT=3100
