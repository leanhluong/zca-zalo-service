{
  "name": "zca-zalo-service",
  "version": "1.0.0",
  "description": "Backend API service cho Zalo cá nhân qua zca-js — đăng nhập QR, gửi/nhận tin, nhóm, bạn bè, đồng bộ lịch sử.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run build && node --env-file=.env --watch dist/index.js",
    "test": "npm run build && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "image-size": "^1.2.0",
    "uuid": "^9.0.0",
    "zca-js": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.9.3"
  }
}
